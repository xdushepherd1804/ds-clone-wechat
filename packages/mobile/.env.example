# =============================================================================
# wechat-clone — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#
#   cp .env.example .env
#
# Secrets (JWT_SECRET, passwords) belong in .env — never commit .env to git.
# =============================================================================

# ----------------------------- Node Environment -----------------------------
# development | staging | production
NODE_ENV=development

# -------------------------------- JWT ---------------------------------------
# Required. Used to sign and verify JWT tokens. Generate a strong random secret:
#   openssl rand -hex 64
JWT_SECRET=change-me-to-a-random-secret

# ----------------------------- PostgreSQL -----------------------------------
# Connection string used by Prisma / pg driver.
DATABASE_URL=postgresql://wechat:wechat_dev@localhost:5432/wechat?schema=public

# Alternatively, set individual parts (used by config YAML in staging/prod):
# PG_HOST=localhost
# PG_USER=wechat_dev
# PG_PASSWORD=wechat_dev

# ------------------------------- MongoDB ------------------------------------
# Connection string used by the MongoDB driver (not Prisma).
MONGODB_URL=mongodb://wechat:wechat_dev@localhost:27017/wechat?authSource=admin

# -------------------------------- Redis -------------------------------------
# Connection string for Redis.
REDIS_URL=redis://localhost:6379
